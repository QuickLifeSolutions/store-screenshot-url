{
    "actorSpecification": 1,
    "name": "screenshot-url",
    "title": "Website Screenshot Generator",
    "description": "Capture full-page or viewport PNG screenshots from a list of URLs. Export page URLs and image links for visual QA, monitoring, and archives.",
    "version": "0.0",
    "meta": {
        "templateId": "js-crawlee-puppeteer-chrome"
    },
    "input": "./input_schema.json",
    "dockerfile": "./Dockerfile",
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Output",
            "description": "One row per successful capture. PNG files are in the run key-value store.",
            "views": {
                "overview": {
                    "title": "Overview",
                    "description": "Selected fields from the dataset",
                    "transformation": {
                        "fields": [
                            "url",
                            "screenshotUrl"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "columns": [
                            {
								"label": "URL",
								"format": "link",
								"field": "url"
							},
                            {
								"label": "Screenshot URL",
								"format": "link",
								"field": "screenshotUrl"
							},
                            {
                                "label": "Screenshot Image",
                                "format": "image",
                                "field": "screenshotUrl"
                            }
                        ]
                    }
                }
            }
        }
    }
}
